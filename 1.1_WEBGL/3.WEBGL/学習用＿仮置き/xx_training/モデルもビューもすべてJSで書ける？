// 頂点シェーダー
uniform mat4 u_matrix;
attribute vec3 a_position;

void main(void) {
    gl_Position = u_matrix * vec4(a_position, 1.0);
}
結論
最初にモデル行列を適用し、次にビュー行列とプロジェクション行列を掛けることで、シェーダー内で効率的に変換を行うことができます。JavaScript側であらかじめ行列をすべて掛け合わせてシェーダーに送る方法もありますが、アニメーションやインタラクティブな変換が必要な場合は、シェーダー内での行列計算のほうが柔軟です。









